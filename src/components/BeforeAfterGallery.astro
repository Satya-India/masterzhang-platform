---
import type { Locale } from '@/lib/i18n';
import { getDict } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale).gallery;

/* Unique ids so multiple instances never clash */
const uid = 'ba-' + Math.random().toString(36).slice(2, 8);

/* Real before & after transformation cases with matching photography */
const scenes = [
  {
    beforeWebp: '/gallery/estate-before.webp',
    afterWebp: '/gallery/estate-after.webp',
    beforeJpg: '/gallery/estate-before.jpg',
    afterJpg: '/gallery/estate-after.jpg',
    beforeLabel: t.cases[0].before,
    afterLabel: t.cases[0].after,
    title: t.cases[0].title,
  },
  {
    beforeWebp: '/gallery/reno-before.webp',
    afterWebp: '/gallery/reno-after.webp',
    beforeJpg: '/gallery/reno-before.jpg',
    afterJpg: '/gallery/reno-after.jpg',
    beforeLabel: t.cases[1].before,
    afterLabel: t.cases[1].after,
    title: t.cases[1].title,
  },
  {
    beforeWebp: '/gallery/snow-before.webp',
    afterWebp: '/gallery/snow-after.webp',
    beforeJpg: '/gallery/snow-before.jpg',
    afterJpg: '/gallery/snow-after.jpg',
    beforeLabel: t.cases[2].before,
    afterLabel: t.cases[2].after,
    title: t.cases[2].title,
  },
];
---

<section id="gallery" class="border-b border-ink-800/60 py-24" aria-labelledby="gallery-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-copper-400">{t.eyebrow}</p>
      <h2 id="gallery-heading" class="font-expanded mt-4 text-3xl font-bold text-ink-100 sm:text-5xl">{t.title}</h2>
      <p class="mt-4 text-lg text-ink-300">{t.sub}</p>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-3">
      {
        scenes.map((s, i) => (
          <figure class="edge-glow overflow-hidden rounded-2xl border border-ink-700/60 bg-ink-900 shadow-xl transition-all hover:border-copper-500/40">
            <div class="relative aspect-[16/10] overflow-hidden select-none" data-before-after>
              <!-- AFTER (base layer) -->
              <div class="absolute inset-0">
                <picture>
                  <source srcset={s.afterWebp} type="image/webp" />
                  <img
                    src={s.afterJpg}
                    alt={`${s.title} — ${s.afterLabel}`}
                    class="h-full w-full object-cover"
                    loading="lazy"
                    decoding="async"
                    width="1376"
                    height="768"
                  />
                </picture>
                <span class="absolute bottom-3 right-3 rounded-lg bg-ink-950/85 backdrop-blur-md px-3 py-1 text-xs font-bold text-copper-300 border border-copper-500/30 shadow-md">
                  {s.afterLabel}
                </span>
              </div>

              <!-- BEFORE (clipped layer) -->
              <div class="absolute inset-0" data-before-layer>
                <picture>
                  <source srcset={s.beforeWebp} type="image/webp" />
                  <img
                    src={s.beforeJpg}
                    alt={`${s.title} — ${s.beforeLabel}`}
                    class="h-full w-full object-cover"
                    loading="lazy"
                    decoding="async"
                    width="1376"
                    height="768"
                  />
                </picture>
                <span class="absolute bottom-3 left-3 rounded-lg bg-ink-950/85 backdrop-blur-md px-3 py-1 text-xs font-bold text-ink-200 border border-ink-700 shadow-md">
                  {s.beforeLabel}
                </span>
              </div>


              <!-- Draggable Handle with visual pill button -->
              <div
                class="absolute inset-y-0 z-10 w-0.5 bg-copper-400 shadow-[0_0_12px_rgba(221,154,92,0.9)] flex items-center justify-center pointer-events-none"
                data-handle
                aria-hidden="true"
              >
                <div class="size-7 rounded-full bg-ink-950 border-2 border-copper-400 shadow-lg flex items-center justify-center text-[10px] text-copper-300 font-bold">
                  ◀▶
                </div>
              </div>

              <!-- Range Input (invisible overlay) -->
              <input
                type="range"
                min="0"
                max="100"
                value="50"
                class="absolute inset-0 z-20 h-full w-full cursor-ew-resize opacity-0"
                aria-label={`${s.title} — before / after comparison slider`}
                data-slider={`${uid}-${i}`}
              />
            </div>

            <figcaption class="flex items-center justify-between px-5 py-4 border-t border-ink-800/80 bg-ink-950/50">
              <span class="text-sm font-semibold text-ink-100">{s.title}</span>
              <span class="text-xs text-ink-400 font-medium">{i + 1} / {scenes.length}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLInputElement>('[data-slider]').forEach((slider) => {
    const wrap = slider.closest('[data-before-after]') as HTMLElement;
    const beforeLayer = wrap.querySelector<HTMLElement>('[data-before-layer]')!;
    const handle = wrap.querySelector<HTMLElement>('[data-handle]')!;
    const update = () => {
      const v = Number(slider.value);
      beforeLayer.style.clipPath = `inset(0 ${100 - v}% 0 0)`;
      handle.style.left = `${v}%`;
    };
    slider.addEventListener('input', update);
    update();
  });
</script>
