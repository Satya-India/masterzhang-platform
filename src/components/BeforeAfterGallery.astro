---
import type { Locale } from '@/lib/i18n';
import { getDict } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale).gallery;

/* Unique ids so multiple instances never clash */
const uid = 'ba-' + Math.random().toString(36).slice(2, 8);

/* CSS-composed scenes: before (cluttered / dusty / snowy) vs after (clean).
   Zero image requests = zero LCP cost, zero CLS. */
const scenes = [
  {
    before: `repeating-linear-gradient(35deg, #24303f 0 14px, #1c2632 14px 28px), repeating-linear-gradient(-35deg, #2c3a4c 0 18px, #1c2632 18px 36px)`,
    after: `linear-gradient(160deg, #19222e 0%, #0c1118 100%)`,
    beforeLabel: t.cases[0].before,
    afterLabel: t.cases[0].after,
    title: t.cases[0].title,
  },
  {
    before: `radial-gradient(circle at 30% 40%, rgba(169,184,202,0.35) 0 12%, transparent 40%), radial-gradient(circle at 70% 60%, rgba(169,184,202,0.28) 0 10%, transparent 36%), linear-gradient(150deg, #2a3441, #171f29)`,
    after: `linear-gradient(150deg, #1c2632, #0c1118)`,
    beforeLabel: t.cases[1].before,
    afterLabel: t.cases[1].after,
    title: t.cases[1].title,
  },
  {
    before: `repeating-linear-gradient(0deg, #d3dde8 0 10px, #c2cedd 10px 20px), linear-gradient(120deg, #aebccb, #8fa1b5)`,
    after: `linear-gradient(160deg, #24303f 0%, #10161d 100%)`,
    beforeLabel: t.cases[2].before,
    afterLabel: t.cases[2].after,
    title: t.cases[2].title,
  },
];
---

<section id="gallery" class="border-b border-ink-800/60 py-24" aria-labelledby="gallery-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-copper-400">{t.eyebrow}</p>
      <h2 id="gallery-heading" class="font-expanded mt-4 text-3xl font-bold text-ink-100 sm:text-5xl">{t.title}</h2>
      <p class="mt-4 text-lg text-ink-300">{t.sub}</p>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-3">
      {
        scenes.map((s, i) => (
          <figure class="edge-glow overflow-hidden rounded-2xl border border-ink-700/60 bg-ink-900">
            <div class="relative aspect-[16/10] overflow-hidden" data-before-after>
              <!-- AFTER (base layer) -->
              <div class="absolute inset-0" style={`background:${s.after}`} aria-hidden="true">
                <span class="absolute bottom-3 right-3 rounded-md bg-ink-950/70 px-2.5 py-1 text-xs font-semibold text-copper-300">
                  {s.afterLabel}
                </span>
              </div>
              <!-- BEFORE (clipped layer) -->
              <div class="absolute inset-0" style={`background:${s.before}`} aria-hidden="true" data-before-layer>
                <span class="absolute bottom-3 left-3 rounded-md bg-ink-950/70 px-2.5 py-1 text-xs font-semibold text-ink-200">
                  {s.beforeLabel}
                </span>
              </div>
              <!-- Handle -->
              <div class="absolute inset-y-0 z-10 w-px bg-copper-400 shadow-[0_0_12px_rgba(221,154,92,0.8)]" data-handle aria-hidden="true" />
              <input
                type="range"
                min="0"
                max="100"
                value="50"
                class="absolute inset-0 z-20 h-full w-full cursor-ew-resize opacity-0"
                aria-label={`${s.title} — before / after comparison`}
                data-slider={`${uid}-${i}`}
              />
            </div>
            <figcaption class="flex items-center justify-between px-5 py-4">
              <span class="text-sm font-semibold text-ink-100">{s.title}</span>
              <span class="text-xs text-ink-500">{i + 1} / {scenes.length}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLInputElement>('[data-slider]').forEach((slider) => {
    const wrap = slider.closest('[data-before-after]') as HTMLElement;
    const beforeLayer = wrap.querySelector<HTMLElement>('[data-before-layer]')!;
    const handle = wrap.querySelector<HTMLElement>('[data-handle]')!;
    const update = () => {
      const v = Number(slider.value);
      beforeLayer.style.clipPath = `inset(0 ${100 - v}% 0 0)`;
      handle.style.left = `${v}%`;
    };
    slider.addEventListener('input', update);
    update();
  });
</script>
