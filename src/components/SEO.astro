---
import { SITE, type Locale } from '@/lib/i18n';

interface Props {
  /** Page title (site suffix appended automatically) */
  title: string;
  description: string;
  /** Canonical path, e.g. "/locations/markham" */
  path: string;
  locale: Locale;
  /** OG image (1200×630) — absolute or site-relative */
  ogImage?: string;
  /** Extra JSON-LD graphs merged into the page (e.g. per-city LocalBusiness) */
  extraSchema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, path, locale, ogImage, extraSchema = [], noindex = false } = Astro.props;

const site = Astro.site ?? new URL('https://masterzhang.ca');
const canonical = new URL(path, site).href;
const ogImageAbs = new URL(ogImage ?? '/og-default.png', site).href;
const htmlLang = locale === 'zh' ? 'zh-CN' : 'en-CA';
const siteName = locale === 'zh' ? SITE.nameZh : SITE.name;

const fullTitle = `${title} | ${siteName}`;

/* Compliance signals exposed to search engines */
const FSAS = [
  'L3P', 'L3R', 'L3S', 'L3T', 'L3X',
  'L4B', 'L4C', 'L4E', 'L4H', 'L4J', 'L4K', 'L4L', 'L4S',
  'L6A', 'L6B', 'L6C', 'L6E', 'L6G',
];
const CITIES = ['Markham', 'Richmond Hill', 'Vaughan', 'Thornhill', 'Unionville'];

/* 4-service offer catalog */
const offerCatalog = {
  '@type': 'OfferCatalog',
  name: 'Property Care Services',
  itemListElement: [
    'Moving Help|395',
    'Move-In / Move-Out Clean & Junk Removal|350',
    'Snow Clearing & Salting|420',
    'Yard & Garden Care|250',
  ].map((entry) => {
    const [serviceType, price] = entry.split('|');
    return {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        serviceType,
        provider: { '@id': `${site.href}#business` },
      },
      priceSpecification: {
        '@type': 'PriceSpecification',
        price: Number(price),
        priceCurrency: 'CAD',
        minPrice: Number(price),
        ...(serviceType.includes('Snow')
          ? { description: 'Seasonal contract, per driveway' }
          : {}),
      },
    };
  }),
};

/* Website schema — signals bilingual content and publisher identity */
const websiteSchema = {
  '@type': 'WebSite',
  '@id': `${site.href}#website`,
  url: site.href,
  name: SITE.name,
  alternateName: SITE.nameZh,
  inLanguage: ['en-CA', 'zh-CN'],
  publisher: { '@id': `${site.href}#business` },
};

/* FAQ schema — improves rich results for common local service questions */
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What areas does Master Zhang serve?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We serve all of York Region, Ontario — including Markham, Richmond Hill, Vaughan, Thornhill and Unionville — with sub-90-minute emergency response from our Markham dispatch hub.',
      },
    },
    {
      '@type': 'Question',
      name: 'How much does local moving cost in Markham?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Moving Help starts from $395 for a 1-bedroom. Get an instant ballpark range in 60 seconds on our website — no email required, price appears before you share contact details.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you offer move-out cleaning and junk removal together?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Our Move-In / Move-Out Clean & Junk Removal service covers both in one booking, starting from $350. Deep clean every room and haul away all junk — no need to hire two companies.',
      },
    },
    {
      '@type': 'Question',
      name: 'How quickly do you respond for snow clearing?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Snow clearing is triggered within 24 hours of every snowfall. Seasonal driveway contracts start from $420 and include salting and ice management.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you serve Chinese-speaking customers? 你们提供中文服务吗？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes — our website and dispatch team are fully bilingual in English and Simplified Chinese (简体中文). Call or estimate online in either language.',
      },
    },
    {
      '@type': 'Question',
      name: 'What payment methods do you accept?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We accept cash, credit card, Interac e-transfer and invoice billing for commercial accounts.',
      },
    },
  ],
};

const mainSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    websiteSchema,
    {
      '@type': ['MovingCompany', 'HomeAndConstructionBusiness', 'LocalBusiness'],
      '@id': `${site.href}#business`,
      name: siteName,
      alternateName: ['张师傅', 'Master Zhang', '张师傅·搬运清洁物业维护'],
      url: site.href,
      image: ogImageAbs,
      logo: new URL('/favicon.svg', site).href,
      telephone: SITE.phone,
      email: SITE.email,
      priceRange: '$$',
      currenciesAccepted: 'CAD',
      paymentAccepted: 'Cash, Credit Card, E-Transfer, Invoice',
      address: {
        '@type': 'PostalAddress',
        ...(SITE.address.street ? { streetAddress: SITE.address.street } : {}),
        addressLocality: SITE.address.city,
        addressRegion: SITE.address.region,
        postalCode: SITE.address.postal,
        addressCountry: SITE.address.country,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: 43.8561,
        longitude: -79.337,
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
          opens: '07:00',
          closes: '21:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: 'Sunday',
          opens: '08:00',
          closes: '18:00',
        },
      ],
      areaServed: [
        ...CITIES.map((c) => ({ '@type': 'City', name: c })),
        ...FSAS.map((f) => ({
          '@type': 'PostalCodeSpecification',
          postalCode: f,
          addressCountry: 'CA',
        })),
      ],
      hasCredential: [
        { '@type': 'Certification', name: 'CVOR — Commercial Vehicle Operator Registration (Ontario)' },
        { '@type': 'Certification', name: 'WSIB Clearance Certificate' },
        { '@type': 'Certification', name: '$5,000,000 Commercial General Liability Insurance' },
      ],
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: '4.9',
        reviewCount: '312',
        bestRating: '5',
      },
      hasOfferCatalog: offerCatalog,
    },
    faqSchema,
    ...extraSchema,
  ],
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Keywords: helps Bing, Baidu and topic-relevance signals -->
<meta name="keywords" content={
  locale === 'zh'
    ? '万锦搬家, 约克区铲雪, 入住清洁, 垃圾清运万锦, 庭院维护, 张师傅, Markham搬家公司'
    : 'moving company Markham, snow removal York Region, move-in cleaning Markham, junk removal Markham, yard care Markham, 张师傅, Master Zhang'
} />

<!-- Geo signals for local SEO -->
<meta name="geo.region" content="CA-ON" />
<meta name="geo.placename" content="Markham, Ontario, Canada" />
<meta name="geo.position" content="43.8561;-79.337" />
<meta name="ICBM" content="43.8561, -79.337" />

<!-- OpenGraph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageAbs} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={htmlLang.replace('-', '_')} />
<meta property="og:locale:alternate" content={locale === 'zh' ? 'en_CA' : 'zh_CN'} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbs} />

<!-- hreflang alternates -->
<link rel="alternate" hreflang={htmlLang} href={canonical} />
<link rel="alternate" hreflang={locale === 'zh' ? 'en-CA' : 'zh-CN'} href={locale === 'zh' ? new URL(path.replace('/zh', '') || '/', site).href : new URL(`/zh${path === '/' ? '' : path}`, site).href} />
<link rel="alternate" hreflang="x-default" href={new URL(path.replace('/zh', '') || '/', site).href} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(mainSchema)} />
