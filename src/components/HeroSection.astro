---
import TrustBadges from '@/components/TrustBadges.astro';
import { SITE, type Locale, getDict } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
const base = locale === 'zh' ? '/zh' : '';

const qc = t.hero.quickCard;

const statsList = [
  { val: 2400, prefix: '', suffix: '+', label: t.hero.stats[0]?.l ?? 'Jobs completed' },
  { val: 100, prefix: '', suffix: '%', label: t.hero.stats[1]?.l ?? 'On-time completion' },
  { val: 90, prefix: '< ', suffix: ' min', label: t.hero.stats[2]?.l ?? 'Emergency dispatch' },
];
---

<section
  class="grain relative overflow-hidden border-b border-ink-800 pt-16"
  aria-labelledby="hero-heading"
>
  <!-- Atmosphere Background -->
  <div class="blueprint absolute inset-0 opacity-40" aria-hidden="true"></div>
  <div class="copper-radial absolute inset-0" aria-hidden="true"></div>
  <div
    class="absolute -right-32 top-1/4 size-[520px] rounded-full bg-copper-600/15 blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -left-32 bottom-10 size-[360px] rounded-full bg-copper-500/10 blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-7xl px-4 pb-20 pt-12 sm:px-6 sm:pt-20 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
      
      <!-- ============================================================= -->
      <!-- LEFT COLUMN: Messaging & Direct Calls to Action               -->
      <!-- ============================================================= -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 rounded-full border border-copper-500/30 bg-copper-500/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-copper-300">
          <span class="size-2 rounded-full bg-copper-400 animate-pulse"></span>
          {t.hero.eyebrow}
        </div>

        <h1
          id="hero-heading"
          class="font-expanded mt-6 text-4xl font-black leading-[1.08] text-ink-100 sm:text-5xl lg:text-6xl"
        >
          {t.hero.titleA}<br />
          <span class="bg-gradient-to-r from-copper-200 via-copper-400 to-amber-glow bg-clip-text text-transparent">
            {t.hero.titleB}
          </span>
        </h1>

        <p class="mt-6 max-w-xl text-base sm:text-lg leading-relaxed text-ink-300">
          {t.hero.sub}
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a
            href={`${base}/#estimator`}
            class="group inline-flex items-center justify-center gap-2 rounded-xl bg-copper-500 px-7 py-4 text-base font-bold text-ink-950 shadow-[0_8px_30px_-6px_rgba(201,123,61,0.6)] transition-all hover:-translate-y-0.5 hover:bg-copper-400"
          >
            {t.hero.ctaPrimary}
            <svg viewBox="0 0 24 24" class="size-5 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
              <path d="M19 14l-7 7m0 0l-7-7m7 7V3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a
            href={`tel:${SITE.phoneHref}`}
            class="inline-flex items-center justify-center gap-2.5 rounded-xl border border-ink-600 bg-ink-900/70 px-6 py-4 text-base font-semibold text-ink-100 backdrop-blur transition-all hover:border-copper-500/60 hover:text-copper-300"
          >
            <svg viewBox="0 0 24 24" class="size-4 text-copper-400" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" stroke-linejoin="round" />
            </svg>
            <span>{t.hero.ctaSecondary}: <strong class="text-ink-100 font-bold">{SITE.phone}</strong></span>
          </a>
        </div>

        <div class="mt-8">
          <TrustBadges locale={locale} />
        </div>

        <!-- Stats -->
        <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-ink-800/80 pt-6">
          {
            statsList.map((s) => (
              <div>
                <dt class="order-2 text-xs text-ink-400 mt-1">{s.label}</dt>
                <dd
                  class="font-expanded order-1 text-2xl sm:text-3xl font-bold text-copper-300"
                  data-countup={String(s.val)}
                  data-prefix={s.prefix}
                  data-suffix={s.suffix}
                >
                  {s.prefix}{s.val.toLocaleString('en-CA')}{s.suffix}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- ============================================================= -->
      <!-- RIGHT COLUMN: Interactive Quick-Card (Concept #3)             -->
      <!-- ============================================================= -->
      <div class="lg:col-span-5" data-quick-card>
        <div class="relative rounded-3xl border border-copper-500/30 bg-gradient-to-b from-ink-900/95 to-ink-950/95 p-6 sm:p-7 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.85)] backdrop-blur-xl">
          
          <!-- Top live status bar -->
          <div class="flex items-center justify-between border-b border-ink-800/80 pb-4">
            <span class="inline-flex items-center gap-2 text-xs font-semibold text-emerald-400">
              <span class="relative flex size-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
              </span>
              {qc.liveStatus}
            </span>
            <span class="text-[11px] font-medium uppercase tracking-wider text-ink-400">
              {qc.title}
            </span>
          </div>

          <!-- Service Tabs -->
          <div class="mt-5 grid grid-cols-4 gap-1.5 rounded-xl bg-ink-950 p-1 border border-ink-800">
            <button
              type="button"
              class="qc-tab active rounded-lg py-2 text-center text-xs font-bold transition-all text-ink-950 bg-copper-500"
              data-tab="moving"
            >
              🚛 {qc.tabs.moving}
            </button>
            <button
              type="button"
              class="qc-tab rounded-lg py-2 text-center text-xs font-bold text-ink-400 transition-all hover:text-ink-200"
              data-tab="cleanup"
            >
              🧹 {qc.tabs.cleanup}
            </button>
            <button
              type="button"
              class="qc-tab rounded-lg py-2 text-center text-xs font-bold text-ink-400 transition-all hover:text-ink-200"
              data-tab="snow"
            >
              ❄️ {qc.tabs.snow}
            </button>
            <button
              type="button"
              class="qc-tab rounded-lg py-2 text-center text-xs font-bold text-ink-400 transition-all hover:text-ink-200"
              data-tab="yard"
            >
              🌿 {qc.tabs.yard}
            </button>
          </div>

          <!-- Dynamic Panel Content -->
          <div class="mt-6">
            <!-- 1. Moving Panel -->
            <div class="qc-panel" data-panel="moving">
              <div class="flex items-baseline justify-between">
                <span class="text-xs uppercase font-bold tracking-wider text-ink-400">{qc.tabs.moving}</span>
                <span class="font-expanded text-xl font-bold text-copper-300">{qc.movingPrice}</span>
              </div>
              <ul class="mt-4 space-y-2.5 text-xs text-ink-300">
                {qc.movingFeatures.map((f: string) => (
                  <li class="flex items-start gap-2">
                    <span class="text-copper-400 mt-0.5">✓</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- 2. Cleanup Panel -->
            <div class="qc-panel hidden" data-panel="cleanup">
              <div class="flex items-baseline justify-between">
                <span class="text-xs uppercase font-bold tracking-wider text-ink-400">{qc.tabs.cleanup}</span>
                <span class="font-expanded text-xl font-bold text-copper-300">{qc.cleanupPrice}</span>
              </div>
              <ul class="mt-4 space-y-2.5 text-xs text-ink-300">
                {qc.cleanupFeatures.map((f: string) => (
                  <li class="flex items-start gap-2">
                    <span class="text-copper-400 mt-0.5">✓</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- 3. Snow Panel -->
            <div class="qc-panel hidden" data-panel="snow">
              <div class="flex items-baseline justify-between">
                <span class="text-xs uppercase font-bold tracking-wider text-ink-400">{qc.tabs.snow}</span>
                <span class="font-expanded text-xl font-bold text-copper-300">{qc.snowPrice}</span>
              </div>
              <ul class="mt-4 space-y-2.5 text-xs text-ink-300">
                {qc.snowFeatures.map((f: string) => (
                  <li class="flex items-start gap-2">
                    <span class="text-copper-400 mt-0.5">✓</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- 4. Yard Panel -->
            <div class="qc-panel hidden" data-panel="yard">
              <div class="flex items-baseline justify-between">
                <span class="text-xs uppercase font-bold tracking-wider text-ink-400">{qc.tabs.yard}</span>
                <span class="font-expanded text-xl font-bold text-copper-300">{qc.yardPrice}</span>
              </div>
              <ul class="mt-4 space-y-2.5 text-xs text-ink-300">
                {qc.yardFeatures.map((f: string) => (
                  <li class="flex items-start gap-2">
                    <span class="text-copper-400 mt-0.5">✓</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Bottom Action Button: smooth scrolls and selects service in estimator -->
          <div class="mt-6 border-t border-ink-800/80 pt-5">
            <button
              type="button"
              id="qc-action-btn"
              class="w-full rounded-xl bg-copper-500 py-3.5 text-center text-sm font-bold text-ink-950 shadow-[0_4px_20px_rgba(201,123,61,0.4)] transition-all hover:bg-copper-400 hover:shadow-[0_6px_25px_rgba(201,123,61,0.6)]"
            >
              {qc.actionBtn}
            </button>
            <p class="mt-2.5 text-center text-[11px] text-ink-400">
              {qc.note}
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  /* Quick Card Interactive Controller */
  const qcContainer = document.querySelector('[data-quick-card]');
  if (qcContainer) {
    let currentService = 'moving';
    const tabs = qcContainer.querySelectorAll<HTMLButtonElement>('.qc-tab');
    const panels = qcContainer.querySelectorAll<HTMLElement>('.qc-panel');
    const actionBtn = qcContainer.querySelector<HTMLButtonElement>('#qc-action-btn');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab!;
        currentService = target;

        // Update active tab style
        tabs.forEach((t) => {
          t.classList.remove('bg-copper-500', 'text-ink-950', 'active');
          t.classList.add('text-ink-400');
        });
        tab.classList.add('bg-copper-500', 'text-ink-950', 'active');
        tab.classList.remove('text-ink-400');

        // Switch visible panel
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.dataset.panel !== target);
        });
      });
    });

    // Action button: smoothly scroll to estimator and select the active service!
    if (actionBtn) {
      actionBtn.addEventListener('click', () => {
        const estimatorEl = document.querySelector('#estimator');
        if (estimatorEl) {
          estimatorEl.scrollIntoView({ behavior: 'smooth' });

          // Auto-trigger service selection in the estimator
          setTimeout(() => {
            const svcBtn = document.querySelector<HTMLButtonElement>(`[data-select="service"][data-value="${currentService}"]`);
            if (svcBtn) {
              svcBtn.click();
            }
          }, 400);
        }
      });
    }
  }
</script>
