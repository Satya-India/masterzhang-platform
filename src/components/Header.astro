---
import { LOCALES, SITE, type Locale, getDict } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);

/** Determine the sibling link for the language toggle */
const currentPath = Astro.url.pathname;
const isZh = currentPath.startsWith('/zh');
const basePath = isZh ? (currentPath.replace(/^\/zh/, '') || '/') : currentPath;
const toggleHref = (target: Locale) => (target === 'zh' ? `/zh${basePath === '/' ? '' : basePath}` : basePath);
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-ink-800/60 bg-ink-950/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <!-- Wordmark -->
    <a href={locale === 'zh' ? '/zh' : '/'} class="flex items-center gap-3" aria-label={SITE.name}>
      <span class="grid size-10 place-items-center rounded-lg border border-copper-500/40 bg-ink-900">
        <svg viewBox="0 0 24 24" class="size-6 text-copper-400" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M2 7h11v9H2z" stroke-linejoin="round" />
          <path d="M13 10h4l3 3v3h-7v-6z" stroke-linejoin="round" />
          <circle cx="6.5" cy="17.5" r="1.8" />
          <circle cx="16.5" cy="17.5" r="1.8" />
        </svg>
      </span>
      <span class="leading-tight">
        <span class="font-expanded block text-[15px] font-bold tracking-wide text-ink-100">
          NEXUS CARE
        </span>
        <span class="block text-[11px] text-ink-400">
          {locale === 'zh' ? '搬家 · 清洁 · 物业维护' : 'Moving · Cleaning · Property Care'}
        </span>
      </span>

    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-7 text-sm text-ink-300 lg:flex" aria-label="Primary">
      <a class="transition-colors hover:text-copper-300" href={(locale === 'zh' ? '/zh' : '') + '/#services'}>{t.nav.services}</a>
      <a class="transition-colors hover:text-copper-300" href={(locale === 'zh' ? '/zh' : '') + '/#areas'}>{t.nav.areas}</a>
      <a class="transition-colors hover:text-copper-300" href={(locale === 'zh' ? '/zh' : '') + '/#reviews'}>{t.nav.reviews}</a>
      <a class="rounded-full border border-ink-600 px-4 py-1.5 transition-colors hover:border-copper-500 hover:text-copper-300" href={(locale === 'zh' ? '/zh' : '') + '/#estimator'}>{t.nav.estimate}</a>
      <a
        class="rounded-full bg-copper-500 px-4 py-1.5 font-semibold text-ink-950 transition-colors hover:bg-copper-400"
        href={`mailto:${SITE.rfpEmail}?subject=${encodeURIComponent('Commercial RFP / Vendor Account')}`}
      >{t.nav.commercial}</a>
    </nav>

    <div class="flex items-center gap-3">
      <!-- Language toggle -->
      <nav class="flex overflow-hidden rounded-full border border-ink-600 text-xs font-semibold" aria-label="Language">
        {LOCALES.map((l) => (
          <a
            href={toggleHref(l.code)}
            hreflang={l.htmlLang}
            aria-current={l.code === locale ? 'true' : undefined}
            class:list={[
              'px-3 py-1.5 transition-colors',
              l.code === locale ? 'bg-copper-500 text-ink-950' : 'text-ink-300 hover:bg-ink-800',
            ]}
          >
            {l.label}
          </a>
        ))}
      </nav>
      <a
        href={`tel:${SITE.phoneHref}`}
        class="hidden items-center gap-2 rounded-full border border-copper-500/50 px-4 py-1.5 text-sm font-semibold text-copper-300 transition-colors hover:bg-copper-500/10 sm:flex"
      >
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" stroke-linejoin="round" />
        </svg>
        {SITE.phone}
      </a>
    </div>
  </div>
</header>
