---
import type { Locale, Dict } from '@/lib/i18n';
import { getDict } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t: Dict = getDict(locale);

/* Static line-art glyphs per vertical — zero image weight, zero CLS */
const glyphs: Record<string, string> = {
  moving:
    'M3 7h11v9H3zM14 10h3.5l2.5 2.5V16h-6v-6zM7 18.5a1.8 1.8 0 1 1-3.6 0 1.8 1.8 0 0 1 3.6 0zm12 0a1.8 1.8 0 1 1-3.6 0 1.8 1.8 0 0 1 3.6 0z',
  /** Broom/sweep — represents combined move-in/out clean + junk haul-away */
  cleanup:
    'M12 3v6m0 0-5 5a3.5 3.5 0 0 0 5 5l5-5-5-5zM4 21h16',
  snow:
    'M12 2v20M4 6l16 12M20 6 4 18M12 6l-2.5 3L12 12l2.5-3L12 6zm0 12-2.5-3L12 12l2.5 3L12 18z',
  yard:
    'M12 21V9m0 0c0-3 2-5.5 5-6-.4 3-2 5-5 6zm0 0c0-3-2-5.5-5-6 .4 3 2 5 5 6zM6 21h12',
};
---

<section id="services" class="relative border-b border-ink-800/60 py-24" aria-labelledby="services-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-copper-400">{t.services.eyebrow}</p>
      <h2 id="services-heading" class="font-expanded mt-4 text-3xl font-bold text-ink-100 sm:text-5xl">
        {t.services.title}
      </h2>
      <p class="mt-4 text-lg text-ink-300">{t.services.sub}</p>
    </div>

    <!-- 4 equal cards: 1 col mobile → 2 col tablet → 4 col desktop -->
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {
        t.services.items.map((s) => (
          <article class="edge-glow edge-glow-hover group relative flex flex-col rounded-2xl border border-ink-700/60 bg-gradient-to-b from-ink-850 to-ink-900 p-7">
            <div class="flex size-14 shrink-0 items-center justify-center rounded-xl border border-copper-500/30 bg-ink-950">
              <svg viewBox="0 0 24 24" class="size-7 text-copper-400" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={glyphs[s.id]} />
              </svg>
            </div>
            <div class="mt-5 flex-1">
              <h3 class="font-expanded text-xl font-bold text-ink-100">{s.title}</h3>
              <p class="mt-2 text-sm font-semibold uppercase tracking-wider text-copper-400">{s.price}</p>
              <p class="mt-3 text-sm leading-relaxed text-ink-400">{s.desc}</p>
              <a
                href="#estimator"
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-copper-300 transition-colors hover:text-copper-200"
                data-service={s.id}
              >
                {locale === 'zh' ? '获取报价 →' : 'Get a quote →'}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

