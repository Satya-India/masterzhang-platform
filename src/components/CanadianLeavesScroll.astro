---
/**
 * CanadianLeavesScroll.astro
 * --------------------------
 * Ambient floating Canadian maple leaves and fresh blossom petals that
 * react gracefully as the user scrolls up and down the page.
 *
 * Performance-first:
 * - High-DPI Retina canvas rendering (crisp on Mac, iPad, iPhone)
 * - Canvas-based particle physics with pre-rendered offscreen sprites
 * - Runs requestAnimationFrame ONLY while scrolling/settling (0% CPU at idle)
 * - Pointer-events: none (zero click interference with buttons/forms)
 * - Honors prefers-reduced-motion
 */
---

<canvas
  id="canadian-leaves-canvas"
  class="pointer-events-none fixed inset-0 z-30 h-full w-full opacity-90"
  aria-hidden="true"
></canvas>

<script>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const canvas = document.getElementById('canadian-leaves-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    let width = 0;
    let height = 0;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();
    window.addEventListener('resize', resize, { passive: true });

    // Pre-render leaf and blossom petal shapes to offscreen canvases for blazing 60fps rendering
    type SpriteType = 'maple-copper' | 'maple-amber' | 'maple-crimson' | 'maple-freshgreen' | 'petal-pink' | 'petal-rose' | 'petal-white';
    const sprites: Record<string, HTMLCanvasElement> = {};

    const PALETTES: Record<SpriteType, [string, string]> = {
      'maple-copper':      ['#d98236', '#9c5417'],
      'maple-amber':       ['#f59e0b', '#b45309'],
      'maple-crimson':     ['#ef4444', '#991b1b'],
      'maple-freshgreen':  ['#22c55e', '#15803d'],
      'petal-pink':        ['#fbcfe8', '#f472b6'],
      'petal-rose':        ['#fda4af', '#e11d48'],
      'petal-white':       ['#ffffff', '#fecdd3'],
    };

    /** Draw a classic 11-point Canadian maple leaf path */
    function drawMapleLeafPath(c: CanvasRenderingContext2D, size: number) {
      const s = size / 32;
      c.beginPath();
      // Center top lobe
      c.moveTo(0 * s, -16 * s);
      c.lineTo(2.8 * s, -9.5 * s);
      c.lineTo(7.5 * s, -12.5 * s);
      c.lineTo(6.5 * s, -5.5 * s);
      c.lineTo(13.5 * s, -3.2 * s);
      // Right upper lobe
      c.lineTo(9 * s, 1.2 * s);
      c.lineTo(14.5 * s, 6.8 * s);
      c.lineTo(8 * s, 7 * s);
      c.lineTo(5 * s, 11.5 * s);
      c.lineTo(1.8 * s, 8 * s);
      // Stem
      c.lineTo(1.2 * s, 16 * s);
      c.lineTo(-1.2 * s, 16 * s);
      c.lineTo(-1.8 * s, 8 * s);
      // Left upper lobe
      c.lineTo(-5 * s, 11.5 * s);
      c.lineTo(-8 * s, 7 * s);
      c.lineTo(-14.5 * s, 6.8 * s);
      c.lineTo(-9 * s, 1.2 * s);
      // Left center lobe
      c.lineTo(-13.5 * s, -3.2 * s);
      c.lineTo(-6.5 * s, -5.5 * s);
      c.lineTo(-7.5 * s, -12.5 * s);
      c.lineTo(-2.8 * s, -9.5 * s);
      c.closePath();
    }

    /** Draw a soft natural flower petal path */
    function drawPetalPath(c: CanvasRenderingContext2D, size: number) {
      const s = size / 24;
      c.beginPath();
      c.moveTo(0, 10 * s);
      c.bezierCurveTo(7 * s, 6 * s, 9 * s, -3 * s, 0, -12 * s);
      c.bezierCurveTo(-9 * s, -3 * s, -7 * s, 6 * s, 0, 10 * s);
      c.closePath();
    }

    function initSprites() {
      const types: SpriteType[] = [
        'maple-copper',
        'maple-amber',
        'maple-crimson',
        'maple-freshgreen',
        'petal-pink',
        'petal-rose',
        'petal-white',
      ];
      const sizes = [14, 20, 26, 32];

      types.forEach((type) => {
        sizes.forEach((sz) => {
          const off = document.createElement('canvas');
          const spriteSz = Math.ceil(sz * 2.4 * dpr);
          off.width = spriteSz;
          off.height = spriteSz;

          const octx = off.getContext('2d');
          if (!octx) return;

          octx.scale(dpr, dpr);
          octx.translate(sz * 1.2, sz * 1.2);

          const [c1, c2] = PALETTES[type];
          const grad = octx.createRadialGradient(0, -sz * 0.2, 0, 0, 0, sz);
          grad.addColorStop(0, c1);
          grad.addColorStop(1, c2);
          octx.fillStyle = grad;

          // Subtle shadow for realistic depth
          octx.shadowColor = 'rgba(0,0,0,0.18)';
          octx.shadowBlur = 3 * dpr;
          octx.shadowOffsetY = 1.5 * dpr;

          if (type.startsWith('petal-')) {
            drawPetalPath(octx, sz);
          } else {
            drawMapleLeafPath(octx, sz);
          }
          octx.fill();

          sprites[`${type}-${sz}`] = off;
        });
      });
    }
    initSprites();

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      rotation: number;
      vRot: number;
      swayOffset: number;
      swaySpeed: number;
      size: number;
      type: SpriteType;
      opacity: number;
      maxLife: number;
      life: number;
      scaleY: number; // 3D tumbling flip
      vScaleY: number;
    }

    const particles: Particle[] = [];
    const MAX_PARTICLES = 32;
    let animId: number | null = null;
    let lastScrollY = window.scrollY;
    let scrollVelocity = 0;
    let scrollTimer: any = null;

    const weightedTypes: SpriteType[] = [
      'maple-copper',
      'maple-copper',
      'maple-amber',
      'maple-amber',
      'maple-crimson',
      'maple-freshgreen',
      'petal-pink',
      'petal-pink',
      'petal-rose',
      'petal-white',
    ];

    function spawnLeaf(direction: number) {
      if (particles.length >= MAX_PARTICLES) return;

      const type = weightedTypes[Math.floor(Math.random() * weightedTypes.length)];
      const sizes = [14, 20, 26, 30];
      const size = sizes[Math.floor(Math.random() * sizes.length)];

      const isDown = direction >= 0;
      // Spread across visible screen width with gentle margin
      const x = Math.random() * width;
      // Spawn just off the top edge if scrolling down, or near bottom if scrolling up
      const y = isDown ? -25 : height + 25;

      const baseVy = (Math.random() * 1.4 + 0.9) * (isDown ? 1 : -0.7);
      const scrollBoost = Math.min(Math.abs(scrollVelocity) * 0.07, 3.2) * (isDown ? 1 : -0.8);

      particles.push({
        x,
        y,
        vx: (Math.random() - 0.5) * 1.4,
        vy: baseVy + scrollBoost,
        rotation: Math.random() * Math.PI * 2,
        vRot: (Math.random() - 0.5) * 0.045,
        swayOffset: Math.random() * Math.PI * 2,
        swaySpeed: Math.random() * 0.035 + 0.018,
        size,
        type,
        opacity: Math.random() * 0.35 + 0.65,
        maxLife: Math.random() * 220 + 170,
        life: 0,
        scaleY: 1,
        vScaleY: Math.random() * 0.045 + 0.02,
      });
    }

    function update() {
      ctx.clearRect(0, 0, width, height);

      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.life++;

        // Sway & dynamic flutter physics
        p.swayOffset += p.swaySpeed;
        p.x += p.vx + Math.sin(p.swayOffset) * 1.1;
        p.y += p.vy;
        p.rotation += p.vRot;

        // 3D leaf tumbling effect
        p.scaleY = Math.cos(p.life * p.vScaleY);

        // Natural smooth fade in and fade out
        let alpha = p.opacity;
        if (p.life < 25) {
          alpha = (p.life / 25) * p.opacity;
        } else if (p.life > p.maxLife - 45) {
          alpha = ((p.maxLife - p.life) / 45) * p.opacity;
        }

        // Draw leaf sprite
        const sprite = sprites[`${p.type}-${p.size}`];
        if (sprite && alpha > 0.01) {
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rotation);
          ctx.scale(1, Math.abs(p.scaleY));
          ctx.globalAlpha = Math.max(0, Math.min(1, alpha * 0.88));

          const drawSz = p.size * 1.2;
          ctx.drawImage(sprite, -drawSz, -drawSz, drawSz * 2, drawSz * 2);
          ctx.restore();
        }

        // Remove expired particles
        if (p.life >= p.maxLife || p.y < -70 || p.y > height + 70 || p.x < -70 || p.x > width + 70) {
          particles.splice(i, 1);
        }
      }

      if (particles.length > 0) {
        animId = requestAnimationFrame(update);
      } else {
        animId = null;
      }
    }

    function onScroll() {
      const currentScrollY = window.scrollY;
      scrollVelocity = currentScrollY - lastScrollY;
      lastScrollY = currentScrollY;

      // Spawn 1 to 3 leaves/petals per scroll tick
      if (Math.abs(scrollVelocity) > 2) {
        const count = Math.min(Math.floor(Math.abs(scrollVelocity) / 8) + 1, 3);
        for (let i = 0; i < count; i++) {
          spawnLeaf(scrollVelocity);
        }
      }

      // Start loop if not active
      if (!animId) {
        animId = requestAnimationFrame(update);
      }

      // Smooth deceleration
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        scrollVelocity = 0;
      }, 120);
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    // Initial ambient welcome burst (3 soft leaves floating into view)
    setTimeout(() => {
      spawnLeaf(1);
      spawnLeaf(1);
      spawnLeaf(1);
      if (!animId) animId = requestAnimationFrame(update);
    }, 600);
  })();
</script>

