---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import ServiceCards from '@/components/ServiceCards.astro';
import InstantEstimator from '@/components/InstantEstimator.astro';
import BeforeAfterGallery from '@/components/BeforeAfterGallery.astro';
import Reviews from '@/components/Reviews.astro';
import DualFunnelCTA from '@/components/DualFunnelCTA.astro';
import { getDict, type Locale } from '@/lib/i18n';
import { getCollection } from 'astro:content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
const locations = await getCollection('locations');
const areasSummary = locations.map((l) => ({ slug: l.id, ...l.data }));
---

<BaseLayout
  title={locale === 'zh' ? '万锦搬运 · 清洁 · 垃圾清运 · 铲雪' : 'Markham Movers, Deep Cleaning, Junk Removal & Snow Clearing'}
  description={t.hero.sub}
  path={locale === 'zh' ? '/' : '/'}
  {locale}
>
  <HeroSection {locale} />
  <ServiceCards {locale} />
  <InstantEstimator {locale} />

  <!-- Service areas -->
  <section id="areas" class="border-b border-ink-800/60 py-24" aria-labelledby="areas-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-copper-400">{t.areas.eyebrow}</p>
        <h2 id="areas-heading" class="font-expanded mt-4 text-3xl font-bold text-ink-100 sm:text-5xl">
          {t.areas.title}
        </h2>
        <p class="mt-4 text-lg text-ink-300">{t.areas.sub}</p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          areasSummary.map((a) => (
            <a
              href={(locale === 'zh' ? '/zh' : '') + `/locations/${a.slug}/`}
              class="edge-glow edge-glow-hover group rounded-2xl border border-ink-700/60 bg-ink-900 p-6"
            >
              <h3 class="font-expanded text-lg font-bold text-ink-100">
                {locale === 'zh' ? a.nameZh : a.name}
              </h3>
              <dl class="mt-4 space-y-2 text-xs text-ink-400">
                <div class="flex justify-between gap-2">
                  <dt>{t.areas.stats.drive}</dt>
                  <dd class="font-bold text-copper-300">{a.driveTimeMin}</dd>
                </div>
                <div class="flex justify-between gap-2">
                  <dt>{t.areas.stats.jobs}</dt>
                  <dd class="font-bold text-copper-300">{a.jobsCompleted.toLocaleString()}</dd>
                </div>
                <div class="flex justify-between gap-2">
                  <dt>{t.areas.stats.fsa}</dt>
                  <dd class="font-bold text-copper-300">{a.fsaCodes.length}</dd>
                </div>
              </dl>
              <span class="mt-5 inline-block text-xs font-semibold text-copper-400 transition-colors group-hover:text-copper-300">
                {t.areas.viewPage} →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <BeforeAfterGallery {locale} />
  <Reviews {locale} />
  <DualFunnelCTA {locale} />
</BaseLayout>
