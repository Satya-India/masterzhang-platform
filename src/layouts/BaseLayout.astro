---
import '@/styles/global.css';
import '@fontsource-variable/archivo';
import '@fontsource-variable/instrument-sans';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { LOCALES, type Locale } from '@/lib/i18n';

interface Props {
  title: string;
  description: string;
  path: string;
  locale: Locale;
  ogImage?: string;
  extraSchema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, path, locale, ogImage, extraSchema, noindex } = Astro.props;
const htmlLang = locale === 'zh' ? 'zh-CN' : 'en-CA';
const other: Locale = locale === 'zh' ? 'en' : 'zh';
const otherHref = locale === 'zh' ? (path.replace('/zh', '') || '/') : `/zh${path === '/' ? '' : path}`;
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#07090d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {title} {description} {path} {locale} {ogImage} {extraSchema} {noindex} />
  </head>
  <body class="min-h-screen bg-ink-950 font-sans text-ink-100 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-copper-500 focus:px-4 focus:py-2 focus:text-ink-950"
    >
      {locale === 'zh' ? '跳到主要内容' : 'Skip to content'}
    </a>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <script is:inline>
      (function () {
        /* ── Skip if user prefers reduced motion ── */
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        /* ── Scroll Reveal (data-reveal / data-stagger) ── */
        var revealIo = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              /* Apply stagger delays to children before revealing */
              if (el.hasAttribute('data-stagger')) {
                Array.from(el.children).forEach(function (child, i) {
                  child.style.transitionDelay = i * 75 + 'ms';
                });
              }
              el.classList.add('revealed');
              revealIo.unobserve(el);
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -52px 0px' }
        );
        document.querySelectorAll('[data-reveal], [data-stagger]').forEach(function (el) {
          revealIo.observe(el);
        });

        /* ── Count-up (data-countup="940" data-suffix="+" data-prefix="") ── */
        function easeOut(t) { return 1 - Math.pow(1 - t, 3); }

        var countIo = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              var target = parseFloat(el.dataset.countup || '0');
              var suffix = el.dataset.suffix || '';
              var prefix = el.dataset.prefix || '';
              var isFloat = el.dataset.countup.indexOf('.') !== -1;
              var duration = 1400;
              var start = performance.now();

              function tick(now) {
                var progress = Math.min((now - start) / duration, 1);
                var val = target * easeOut(progress);
                el.textContent = prefix + (isFloat ? val.toFixed(1) : Math.round(val)) + suffix;
                if (progress < 1) requestAnimationFrame(tick);
              }
              requestAnimationFrame(tick);
              countIo.unobserve(el);
            });
          },
          { threshold: 0.6 }
        );
        document.querySelectorAll('[data-countup]').forEach(function (el) {
          countIo.observe(el);
        });
      })();
    </script>
  </body>
</html>
