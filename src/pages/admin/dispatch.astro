---
/**
 * /admin/dispatch
 * ---------------
 * Dispatcher dashboard — assign drivers to jobs, copy driver/tracking URLs.
 * Auth-gated: redirects to login if no valid admin cookie.
 */
export const prerender = false;

import { DRIVERS, STATUS_LABELS, type JobStatus } from '@/lib/jobs';

// Auth check
const cookies = Astro.request.headers.get('Cookie') ?? '';
const env = (Astro.locals as any).runtime?.env;
const adminPassword: string = env?.ADMIN_PASSWORD ?? '';

function isAuthenticated(): boolean {
  const match = cookies.match(/mz_admin=([^;]+)/);
  if (!match) return false;
  try {
    const decoded = atob(match[1]);
    return decoded.includes(`:${adminPassword.slice(0, 8)}`);
  } catch { return false; }
}

if (!isAuthenticated()) {
  return Astro.redirect('/admin/login', 302);
}

const driversJson = JSON.stringify(DRIVERS);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Dispatch Dashboard — Master Zhang</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #0a0a0f; color: #e2e0d8; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    header { background: #13131a; border-bottom: 1px solid #1e1e2a; padding: 1rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
    .logo { color: #c8954a; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; }
    .logout { font-size: 0.8rem; color: #6b7280; text-decoration: none; }
    .logout:hover { color: #c8954a; }
    main { max-width: 1100px; margin: 0 auto; padding: 1.5rem; }
    h1 { font-size: 1.75rem; font-weight: 700; margin-bottom: 0.375rem; }
    .subtitle { color: #9ca3af; font-size: 0.875rem; margin-bottom: 1.5rem; }
    .btn-refresh { padding: 0.5rem 1rem; border-radius: 0.625rem; background: #1a1a24; border: 1px solid #2a2a38; color: #e2e0d8; font-size: 0.8rem; cursor: pointer; }
    .btn-refresh:hover { border-color: #c8954a; color: #c8954a; }
    table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
    th { text-align: left; padding: 0.625rem 0.75rem; color: #6b7280; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; border-bottom: 1px solid #1e1e2a; }
    td { padding: 0.875rem 0.75rem; border-bottom: 1px solid #1a1a24; vertical-align: top; }
    tr:hover td { background: #13131a; }
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
    .badge-pending     { background: rgba(107,114,128,0.15); color: #9ca3af; }
    .badge-assigned    { background: rgba(59,130,246,0.15);  color: #60a5fa; }
    .badge-en_route    { background: rgba(245,158,11,0.15);  color: #fbbf24; }
    .badge-arrived     { background: rgba(200,149,74,0.15);  color: #c8954a; }
    .badge-in_progress { background: rgba(34,197,94,0.15);   color: #4ade80; }
    .badge-complete    { background: rgba(34,197,94,0.1);    color: #86efac; }
    .driver-select { padding: 0.5rem 0.625rem; border-radius: 0.5rem; background: #1a1a24; border: 1px solid #2a2a38; color: #e2e0d8; font-size: 0.8rem; width: 100%; }
    .btn-assign { padding: 0.5rem 0.875rem; border-radius: 0.5rem; background: #c8954a; color: #000; font-size: 0.8rem; font-weight: 700; border: none; cursor: pointer; white-space: nowrap; }
    .btn-assign:hover { background: #d4a45e; }
    .btn-assign:disabled { opacity: 0.4; cursor: not-allowed; }
    .url-row { display: flex; align-items: center; gap: 0.375rem; margin-top: 0.25rem; }
    .url-link { font-size: 0.75rem; color: #c8954a; text-decoration: none; font-family: monospace; word-break: break-all; }
    .url-link:hover { text-decoration: underline; }
    .btn-copy { padding: 0.2rem 0.5rem; font-size: 0.7rem; border-radius: 0.375rem; background: #1a1a24; border: 1px solid #2a2a38; color: #9ca3af; cursor: pointer; flex-shrink: 0; }
    .btn-copy:hover { color: #c8954a; border-color: #c8954a; }
    .empty { text-align: center; padding: 3rem; color: #6b7280; }
    .gps-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #22c55e; margin-right: 4px; vertical-align: middle; }
    .gps-dot.stale { background: #4b5563; }
    #loading { text-align: center; padding: 2rem; color: #6b7280; }
    #table-wrap { display: none; }
  </style>
</head>
<body>
  <header>
    <div class="logo">张师傅 · Dispatch Dashboard</div>
    <a class="logout" href="/admin/login">Sign out</a>
  </header>

  <main>
    <div style="display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:0.75rem; margin-bottom:1.5rem;">
      <div>
        <h1>Active Jobs</h1>
        <p class="subtitle">Assign drivers, copy tracking links, monitor status.</p>
      </div>
      <button class="btn-refresh" id="btn-refresh">↻ Refresh</button>
    </div>

    <div id="loading">Loading jobs…</div>

    <div id="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Customer</th>
            <th>Service</th>
            <th>Scheduled</th>
            <th>Status</th>
            <th>GPS</th>
            <th>Driver</th>
            <th>Links</th>
          </tr>
        </thead>
        <tbody id="jobs-body">
        </tbody>
      </table>
      <div class="empty" id="empty-msg" style="display:none;">No jobs yet. Quotes will appear here automatically.</div>
    </div>
  </main>

  <script define:vars={{ driversJson }}>
    const DRIVERS = JSON.parse(driversJson);
    const SERVICE_ICONS = { moving: '🚛', cleanup: '🧹', snow: '❄️', yard: '🌿' };

    function timeSince(isoStr) {
      if (!isoStr) return '—';
      const secs = Math.floor((Date.now() - new Date(isoStr).getTime()) / 1000);
      if (secs < 60) return `${secs}s ago`;
      if (secs < 3600) return `${Math.floor(secs/60)}m ago`;
      return `${Math.floor(secs/3600)}h ago`;
    }

    function formatDate(isoStr) {
      if (!isoStr) return 'TBD';
      try { return new Date(isoStr).toLocaleString('en-CA', { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', hour12:true }); }
      catch { return isoStr; }
    }

    function copy(text, btn) {
      navigator.clipboard.writeText(text).then(() => {
        const orig = btn.textContent;
        btn.textContent = '✓';
        setTimeout(() => (btn.textContent = orig), 1500);
      });
    }

    async function assignDriver(trackToken, driverIndex, btn) {
      btn.disabled = true;
      btn.textContent = 'Assigning…';
      try {
        const res = await fetch('/api/admin/assign', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ trackToken, driverIndex }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error ?? 'Failed');
        // Show URLs
        const row = btn.closest('tr');
        const linksCell = row.querySelector('.links-cell');
        linksCell.innerHTML = `
          <div class="url-row">
            <span style="font-size:0.7rem;color:#6b7280;width:36px">Driver</span>
            <a class="url-link" href="${data.driverUrl}" target="_blank">${location.origin}${data.driverUrl}</a>
            <button class="btn-copy" onclick="copy('${location.origin}${data.driverUrl}', this)">Copy</button>
          </div>
          <div class="url-row" style="margin-top:0.25rem;">
            <span style="font-size:0.7rem;color:#6b7280;width:36px">Track</span>
            <a class="url-link" href="${data.trackUrl}" target="_blank">${location.origin}${data.trackUrl}</a>
            <button class="btn-copy" onclick="copy('${location.origin}${data.trackUrl}', this)">Copy</button>
          </div>
        `;
        row.querySelector('.status-cell').innerHTML = '<span class="badge badge-assigned">Assigned</span>';
        loadJobs();
      } catch (err) {
        alert('Error: ' + err.message);
        btn.disabled = false;
        btn.textContent = 'Assign';
      }
    }

    function renderRow(job) {
      const icon = SERVICE_ICONS[job.serviceType] ?? '📋';
      const isStale = job.lat && (Date.now() - new Date(job.lastUpdated).getTime()) > 120_000;
      const tr = document.createElement('tr');
      tr.dataset.token = job.trackToken;
      tr.innerHTML = `
        <td>
          <div style="font-weight:600;">${job.customerName}</div>
          <div style="font-size:0.75rem;color:#9ca3af;">${job.serviceAddress}</div>
        </td>
        <td>${icon} ${job.serviceType.charAt(0).toUpperCase() + job.serviceType.slice(1)}</td>
        <td style="font-size:0.8rem;">${formatDate(job.scheduledAt)}</td>
        <td class="status-cell">
          <span class="badge badge-${job.status}">${job.status.replace('_',' ')}</span>
        </td>
        <td style="font-size:0.75rem;">
          ${job.lat
            ? `<span class="gps-dot${isStale?' stale':''}"></span>${job.lat.toFixed(4)}, ${job.lng.toFixed(4)}<br/><span style="color:#6b7280;">${timeSince(job.lastUpdated)}</span>`
            : '<span style="color:#4b5563;">No GPS yet</span>'}
        </td>
        <td>
          ${job.driverName
            ? `<div style="font-weight:600;font-size:0.8rem;">${job.driverName}</div><div style="font-size:0.75rem;color:#9ca3af;">${job.vehicleLabel}</div>`
            : `<div style="display:flex;gap:0.5rem;align-items:center;">
                 <select class="driver-select" id="sel-${job.trackToken}">
                   ${DRIVERS.map((d,i) => `<option value="${i}">${d.name}</option>`).join('')}
                 </select>
                 <button class="btn-assign" onclick="assignDriver('${job.trackToken}', parseInt(document.getElementById('sel-${job.trackToken}').value), this)">Assign</button>
               </div>`}
        </td>
        <td class="links-cell">
          ${job.driverName
            ? `<div class="url-row">
                 <span style="font-size:0.7rem;color:#6b7280;width:36px">Track</span>
                 <a class="url-link" href="/track/${job.trackToken}" target="_blank">/track/…${job.trackToken.slice(-6)}</a>
                 <button class="btn-copy" onclick="navigator.clipboard.writeText(location.origin+'/track/${job.trackToken}').then(()=>{this.textContent='✓';setTimeout(()=>{this.textContent='Copy'},1500)})">Copy</button>
               </div>`
            : '<span style="font-size:0.75rem;color:#6b7280;">Assign driver first</span>'}
        </td>
      `;
      return tr;
    }

    async function loadJobs() {
      try {
        const res = await fetch('/api/admin/jobs');
        if (res.status === 401) { location.href = '/admin/login'; return; }
        const jobs = await res.json();
        const tbody = document.getElementById('jobs-body');
        const empty = document.getElementById('empty-msg');
        tbody.innerHTML = '';
        if (jobs.length === 0) {
          empty.style.display = 'block';
        } else {
          empty.style.display = 'none';
          jobs.forEach(j => tbody.appendChild(renderRow(j)));
        }
        document.getElementById('loading').style.display = 'none';
        document.getElementById('table-wrap').style.display = 'block';
      } catch (err) {
        document.getElementById('loading').textContent = 'Failed to load — ' + err.message;
      }
    }

    // Expose helpers to inline onclick handlers
    window.assignDriver = assignDriver;
    window.copy = copy;

    loadJobs();
    document.getElementById('btn-refresh').addEventListener('click', loadJobs);
    // Auto-refresh every 20 seconds
    setInterval(loadJobs, 20_000);
  </script>
</body>
</html>
