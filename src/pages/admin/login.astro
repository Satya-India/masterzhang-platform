---
/**
 * /admin/login
 * Admin dispatcher login page.
 */
export const prerender = false;

const hasError = Astro.url.searchParams.get('error') === '1';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Nexus Care — Dispatcher Login</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #0a0a0f; color: #e2e0d8;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      min-height: 100dvh; display: grid; place-items: center; padding: 1rem;
    }
    .card {
      background: #13131a; border: 1px solid #2a2a38; border-radius: 1.5rem;
      padding: 2.5rem; width: 100%; max-width: 380px;
    }
    .logo { color: #c8954a; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 1.5rem; }
    h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.375rem; }
    p { color: #9ca3af; font-size: 0.875rem; margin-bottom: 2rem; }
    label { display: block; font-size: 0.8rem; font-weight: 600; color: #9ca3af; margin-bottom: 0.375rem; }
    input {
      width: 100%; padding: 0.75rem 1rem; border-radius: 0.75rem;
      background: #1a1a24; border: 1px solid #2a2a38; color: #e2e0d8;
      font-size: 1rem;
    }
    input:focus { outline: 2px solid #c8954a; border-color: transparent; }
    button {
      width: 100%; padding: 0.875rem; border-radius: 0.875rem; margin-top: 1.25rem;
      background: #c8954a; color: #000; font-size: 1rem; font-weight: 700;
      border: none; cursor: pointer;
    }
    button:hover { background: #d4a45e; }
    .error { color: #f87171; font-size: 0.875rem; margin-top: 0.75rem; text-align: center; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">NEXUS CARE · Admin</div>
    <h1>Dispatcher Login</h1>
    <p>Enter the admin password to access the dispatch dashboard.</p>

    <form method="POST" action="/api/admin/login">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required autofocus />
      <button type="submit">Sign In →</button>
      {hasError && <p class="error">Incorrect password — try again.</p>}
    </form>
  </div>
</body>
</html>
